<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ControleEstoquePizzaria" targetNamespace="https://ceub.br/projetos/controle-estoque-pizzaria/bpmn" exporter="OpenAI BPMN XML Generator" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_Estoque">
    <bpmn:participant id="Participant_Deposito" name="Gestão e Operação de Estoque - Depósito da Pizzaria" processRef="Process_Estoque"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Estoque" name="Gestão e Operação de Estoque - Depósito da Pizzaria" processType="None" isClosed="false" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Estoque">
      <bpmn:lane id="Lane_Estoquista" name="Estoquista / Operador de Depósito">
        <bpmn:flowNodeRef>Start_Operacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TipoOperacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A_Conferir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B_SolicitarRetirada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C_LerTemperatura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_D_SolicitarEstorno</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema" name="Sistema de Gestão de Estoque (PostgreSQL)">
        <bpmn:flowNodeRef>Task_A_ValidarFuncionarioValidade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A_ValidarArmazenamento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_A_DadosCapacidadeValidos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A_BloquearNotificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_A_Excecao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A_RegistrarEntrada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_A_Sucesso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B_SelecionarLotes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_B_SaldoSuficiente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B_BloquearInsuficiencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_B_Insuficiente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B_AbaterConfirmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B_ConsultarReposicao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_B_AbaixoReposicao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_B_Normal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C_RegistrarTemperatura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_C_Anomalia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C_ManterNormal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_C_ManterNormal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C_BloquearLoteInterditarLocal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C_RegistrarPerda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C_ConsultarReposicao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_C_AbaixoReposicao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_C_NormalReposicao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_D_ValidarEstorno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_D_EstornoPermitido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_D_RecusarEstorno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_D_Recusado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_D_ExecutarEstorno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_D_ConsultarReposicao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_D_AbaixoReposicao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_D_NormalReposicao</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Gerencia" name="Gerente / Compras">
        <bpmn:flowNodeRef>Task_B_EmitirPedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_B_Pedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_C_EmitirPedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_C_Pedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_D_AutorizarEstorno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_D_EmitirPedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_D_Pedido</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Operacao" name="Chegada de mercadoria do fornecedor ou necessidade de consumo da pizzaria"/>
    <bpmn:exclusiveGateway id="Gateway_TipoOperacao" name="Tipo de operação?" gatewayDirection="Diverging"/>
    <bpmn:userTask id="Task_A_Conferir" name="Conferir nota fiscal, lote, data de fabrico e validade"/>
    <bpmn:serviceTask id="Task_A_ValidarFuncionarioValidade" name="Validar funcionário ativo e validade do lote">
      <bpmn:documentation>Executar as validações associadas a trg_mov_funcionario_ativo e trg_lote_validade. A entrada deve ser rejeitada quando o funcionário não estiver ativo ou quando um produto que controla validade não apresentar data de validade.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_A_ValidarArmazenamento" name="Validar compatibilidade, temperatura e capacidade em kg">
      <bpmn:documentation>Executar trg_estoque_compatibilidade_capacidade para validar compatibilidade entre classe de armazenamento e tipo de local, faixa térmica e capacidade disponível em kg. A operação deve respeitar os bloqueios transacionais e locks definidos no banco.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_A_DadosCapacidadeValidos" name="Dados e capacidade válidos?" gatewayDirection="Diverging"/>
    <bpmn:serviceTask id="Task_A_BloquearNotificar" name="Bloquear entrada e notificar erro ao Estoquista">
      <bpmn:documentation>Não registar o lote nem incrementar o saldo quando qualquer validação crítica falhar.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_A_Excecao" name="Fim — entrada rejeitada"/>
    <bpmn:serviceTask id="Task_A_RegistrarEntrada" name="Executar sp_registrar_entrada e confirmar ENTRADA">
      <bpmn:documentation>Registar lote, actualizar saldo em estoque, registar os itens da movimentação e confirmar a movimentação do tipo ENTRADA.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_A_Sucesso" name="Fim — entrada registada"/>
    <bpmn:userTask id="Task_B_SolicitarRetirada" name="Solicitar retirada de insumo por produto e quantidade"/>
    <bpmn:serviceTask id="Task_B_SelecionarLotes" name="sp_retirar_estoque: seleccionar lotes elegíveis e bloquear com FOR UPDATE">
      <bpmn:documentation>Considerar apenas lotes LIBERADO, com data_validade &gt;= CURRENT_DATE quando aplicável, e local de armazenamento ATIVO. Ordenar por PVPS (menor validade primeiro) ou PEPS (recebimento mais antigo), conforme a política definida, e bloquear as linhas elegíveis com FOR UPDATE. Nota de conformidade: confirmar no DDL que a alternância PEPS configurável está implementada; este processo representa o requisito PVPS/PEPS solicitado.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_B_SaldoSuficiente" name="Saldo disponível suficiente?" gatewayDirection="Diverging"/>
    <bpmn:serviceTask id="Task_B_BloquearInsuficiencia" name="Bloquear consumo e alertar falta de stock">
      <bpmn:documentation>Não confirmar a movimentação nem permitir que o saldo fique negativo.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_B_Insuficiente" name="Fim — stock insuficiente"/>
    <bpmn:serviceTask id="Task_B_AbaterConfirmar" name="Abater saldos por lote, registar itens e confirmar CONSUMO">
      <bpmn:documentation>Debitar os lotes seleccionados, registar os itens da movimentação e confirmar a movimentação do tipo CONSUMO. A operação deve preservar a integridade do saldo sob concorrência.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_B_ConsultarReposicao" name="Consultar vw_alerta_reposicao após CONSUMO">
      <bpmn:documentation>Avaliar quantidade_disponivel em relação a ponto_reposicao. Considerar os estados CRITICO, REPOR e NORMAL.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_B_AbaixoReposicao" name="Abaixo do ponto de reposição?" gatewayDirection="Diverging"/>
    <bpmn:endEvent id="End_B_Normal" name="Fim — nível NORMAL"/>
    <bpmn:userTask id="Task_B_EmitirPedido" name="Analisar alerta REPOR/CRITICO e emitir pedido com quantidade_reposicao"/>
    <bpmn:endEvent id="End_B_Pedido" name="Fim — pedido de compra emitido"/>
    <bpmn:userTask id="Task_C_LerTemperatura" name="Registar leitura de temperatura do local"/>
    <bpmn:serviceTask id="Task_C_RegistrarTemperatura" name="Registar leitura em registro_temperatura">
      <bpmn:documentation>Persistir a leitura térmica associada ao local, data/hora e responsável.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_C_Anomalia" name="Temperatura fora da faixa ou lote vencido?" gatewayDirection="Diverging"/>
    <bpmn:serviceTask id="Task_C_ManterNormal" name="Manter lote/local em operação normal">
      <bpmn:documentation>Quando não existir desvio térmico nem lote vencido, manter o estado operacional sem registar perda.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_C_ManterNormal" name="Fim — operação normal"/>
    <bpmn:serviceTask id="Task_C_BloquearLoteInterditarLocal" name="Bloquear lote ou interditar local">
      <bpmn:documentation>Quando aplicável, alterar o estado do lote para BLOQUEADO ou o estado do local para INTERDITADO.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_C_RegistrarPerda" name="Registar movimentação PERDA e acção de descarte">
      <bpmn:documentation>Registar a movimentação PERDA e a acção tomada. Para lotes vencidos, PERDA é a única saída permitida; não permitir CONSUMO.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_C_ConsultarReposicao" name="Consultar vw_alerta_reposicao após PERDA">
      <bpmn:documentation>Reavaliar quantidade_disponivel e ponto_reposicao após o registo da saída PERDA.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_C_AbaixoReposicao" name="Abaixo do ponto de reposição?" gatewayDirection="Diverging"/>
    <bpmn:endEvent id="End_C_NormalReposicao" name="Fim — nível NORMAL após PERDA"/>
    <bpmn:userTask id="Task_C_EmitirPedido" name="Analisar alerta REPOR/CRITICO e emitir pedido com quantidade_reposicao"/>
    <bpmn:endEvent id="End_C_Pedido" name="Fim — pedido de compra emitido"/>
    <bpmn:userTask id="Task_D_SolicitarEstorno" name="Solicitar estorno de movimentação CONFIRMADA (Estoquista/Gerente) e apresentar justificativa"/>
    <bpmn:serviceTask id="Task_D_ValidarEstorno" name="Validar movimentação CONFIRMADA, não estornada e saldo reversível">
      <bpmn:documentation>Verificar se a movimentação original está CONFIRMADA, se ainda não foi estornada e se existe saldo suficiente para efectuar a reversão.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_D_EstornoPermitido" name="Estorno permitido?" gatewayDirection="Diverging"/>
    <bpmn:serviceTask id="Task_D_RecusarEstorno" name="Rejeitar estorno e informar motivo">
      <bpmn:documentation>Rejeitar se a movimentação já estiver estornada, não estiver CONFIRMADA ou se o saldo não permitir a reversão.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_D_Recusado" name="Fim — estorno rejeitado"/>
    <bpmn:userTask id="Task_D_AutorizarEstorno" name="Analisar solicitação e autorizar estorno"/>
    <bpmn:serviceTask id="Task_D_ExecutarEstorno" name="Executar sp_estornar_movimentacao e criar ESTORNO inverso">
      <bpmn:documentation>Revalidar as condições transaccionais, criar a movimentação inversa do tipo ESTORNO e marcar a movimentação original como ESTORNADA. Não apagar nem editar os itens confirmados; trg_item_proteger_confirmado preserva o histórico.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_D_ConsultarReposicao" name="Consultar vw_alerta_reposicao após ESTORNO">
      <bpmn:documentation>Avaliar quantidade_disponivel em relação a ponto_reposicao após a movimentação inversa.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_D_AbaixoReposicao" name="Abaixo do ponto de reposição?" gatewayDirection="Diverging"/>
    <bpmn:endEvent id="End_D_NormalReposicao" name="Fim — nível NORMAL após ESTORNO"/>
    <bpmn:userTask id="Task_D_EmitirPedido" name="Analisar alerta REPOR/CRITICO e emitir pedido com quantidade_reposicao"/>
    <bpmn:endEvent id="End_D_Pedido" name="Fim — pedido de compra emitido"/>
    <bpmn:sequenceFlow id="Flow_Start_Tipo" sourceRef="Start_Operacao" targetRef="Gateway_TipoOperacao"/>
    <bpmn:sequenceFlow id="Flow_Tipo_A" sourceRef="Gateway_TipoOperacao" targetRef="Task_A_Conferir" name="A · RECEPÇÃO / ENTRADA"/>
    <bpmn:sequenceFlow id="Flow_Tipo_B" sourceRef="Gateway_TipoOperacao" targetRef="Task_B_SolicitarRetirada" name="B · RETIRADA / CONSUMO"/>
    <bpmn:sequenceFlow id="Flow_Tipo_C" sourceRef="Gateway_TipoOperacao" targetRef="Task_C_LerTemperatura" name="C · MONITORIZAÇÃO / PERDA"/>
    <bpmn:sequenceFlow id="Flow_Tipo_D" sourceRef="Gateway_TipoOperacao" targetRef="Task_D_SolicitarEstorno" name="D · CORRECÇÃO / ESTORNO"/>
    <bpmn:sequenceFlow id="Flow_A_Conferir_Validar1" sourceRef="Task_A_Conferir" targetRef="Task_A_ValidarFuncionarioValidade"/>
    <bpmn:sequenceFlow id="Flow_A_Validar1_Validar2" sourceRef="Task_A_ValidarFuncionarioValidade" targetRef="Task_A_ValidarArmazenamento"/>
    <bpmn:sequenceFlow id="Flow_A_Validar2_Gateway" sourceRef="Task_A_ValidarArmazenamento" targetRef="Gateway_A_DadosCapacidadeValidos"/>
    <bpmn:sequenceFlow id="Flow_A_Nao" sourceRef="Gateway_A_DadosCapacidadeValidos" targetRef="Task_A_BloquearNotificar" name="Não"/>
    <bpmn:sequenceFlow id="Flow_A_Bloquear_Fim" sourceRef="Task_A_BloquearNotificar" targetRef="End_A_Excecao"/>
    <bpmn:sequenceFlow id="Flow_A_Sim" sourceRef="Gateway_A_DadosCapacidadeValidos" targetRef="Task_A_RegistrarEntrada" name="Sim"/>
    <bpmn:sequenceFlow id="Flow_A_Entrada_Fim" sourceRef="Task_A_RegistrarEntrada" targetRef="End_A_Sucesso"/>
    <bpmn:sequenceFlow id="Flow_B_Solicitar_Selecionar" sourceRef="Task_B_SolicitarRetirada" targetRef="Task_B_SelecionarLotes"/>
    <bpmn:sequenceFlow id="Flow_B_Selecionar_Gateway" sourceRef="Task_B_SelecionarLotes" targetRef="Gateway_B_SaldoSuficiente"/>
    <bpmn:sequenceFlow id="Flow_B_Nao" sourceRef="Gateway_B_SaldoSuficiente" targetRef="Task_B_BloquearInsuficiencia" name="Não"/>
    <bpmn:sequenceFlow id="Flow_B_Bloquear_Fim" sourceRef="Task_B_BloquearInsuficiencia" targetRef="End_B_Insuficiente"/>
    <bpmn:sequenceFlow id="Flow_B_Sim" sourceRef="Gateway_B_SaldoSuficiente" targetRef="Task_B_AbaterConfirmar" name="Sim"/>
    <bpmn:sequenceFlow id="Flow_B_Abater_Consultar" sourceRef="Task_B_AbaterConfirmar" targetRef="Task_B_ConsultarReposicao"/>
    <bpmn:sequenceFlow id="Flow_B_Consultar_Gateway" sourceRef="Task_B_ConsultarReposicao" targetRef="Gateway_B_AbaixoReposicao"/>
    <bpmn:sequenceFlow id="Flow_B_Normal" sourceRef="Gateway_B_AbaixoReposicao" targetRef="End_B_Normal" name="Não · NORMAL"/>
    <bpmn:sequenceFlow id="Flow_B_Repor" sourceRef="Gateway_B_AbaixoReposicao" targetRef="Task_B_EmitirPedido" name="Sim · REPOR / CRITICO"/>
    <bpmn:sequenceFlow id="Flow_B_Pedido_Fim" sourceRef="Task_B_EmitirPedido" targetRef="End_B_Pedido"/>
    <bpmn:sequenceFlow id="Flow_C_Ler_Registrar" sourceRef="Task_C_LerTemperatura" targetRef="Task_C_RegistrarTemperatura"/>
    <bpmn:sequenceFlow id="Flow_C_Registrar_Gateway" sourceRef="Task_C_RegistrarTemperatura" targetRef="Gateway_C_Anomalia"/>
    <bpmn:sequenceFlow id="Flow_C_Nao" sourceRef="Gateway_C_Anomalia" targetRef="Task_C_ManterNormal" name="Não"/>
    <bpmn:sequenceFlow id="Flow_C_Manter_Fim" sourceRef="Task_C_ManterNormal" targetRef="End_C_ManterNormal"/>
    <bpmn:sequenceFlow id="Flow_C_Sim" sourceRef="Gateway_C_Anomalia" targetRef="Task_C_BloquearLoteInterditarLocal" name="Sim"/>
    <bpmn:sequenceFlow id="Flow_C_Bloquear_Perda" sourceRef="Task_C_BloquearLoteInterditarLocal" targetRef="Task_C_RegistrarPerda"/>
    <bpmn:sequenceFlow id="Flow_C_Perda_Consultar" sourceRef="Task_C_RegistrarPerda" targetRef="Task_C_ConsultarReposicao"/>
    <bpmn:sequenceFlow id="Flow_C_Consultar_Gateway" sourceRef="Task_C_ConsultarReposicao" targetRef="Gateway_C_AbaixoReposicao"/>
    <bpmn:sequenceFlow id="Flow_C_Normal" sourceRef="Gateway_C_AbaixoReposicao" targetRef="End_C_NormalReposicao" name="Não · NORMAL"/>
    <bpmn:sequenceFlow id="Flow_C_Repor" sourceRef="Gateway_C_AbaixoReposicao" targetRef="Task_C_EmitirPedido" name="Sim · REPOR / CRITICO"/>
    <bpmn:sequenceFlow id="Flow_C_Pedido_Fim" sourceRef="Task_C_EmitirPedido" targetRef="End_C_Pedido"/>
    <bpmn:sequenceFlow id="Flow_D_Solicitar_Validar" sourceRef="Task_D_SolicitarEstorno" targetRef="Task_D_ValidarEstorno"/>
    <bpmn:sequenceFlow id="Flow_D_Validar_Gateway" sourceRef="Task_D_ValidarEstorno" targetRef="Gateway_D_EstornoPermitido"/>
    <bpmn:sequenceFlow id="Flow_D_Nao" sourceRef="Gateway_D_EstornoPermitido" targetRef="Task_D_RecusarEstorno" name="Não"/>
    <bpmn:sequenceFlow id="Flow_D_Recusar_Fim" sourceRef="Task_D_RecusarEstorno" targetRef="End_D_Recusado"/>
    <bpmn:sequenceFlow id="Flow_D_Sim_Autorizar" sourceRef="Gateway_D_EstornoPermitido" targetRef="Task_D_AutorizarEstorno" name="Sim"/>
    <bpmn:sequenceFlow id="Flow_D_Autorizar_Executar" sourceRef="Task_D_AutorizarEstorno" targetRef="Task_D_ExecutarEstorno"/>
    <bpmn:sequenceFlow id="Flow_D_Executar_Consultar" sourceRef="Task_D_ExecutarEstorno" targetRef="Task_D_ConsultarReposicao"/>
    <bpmn:sequenceFlow id="Flow_D_Consultar_Gateway" sourceRef="Task_D_ConsultarReposicao" targetRef="Gateway_D_AbaixoReposicao"/>
    <bpmn:sequenceFlow id="Flow_D_Normal" sourceRef="Gateway_D_AbaixoReposicao" targetRef="End_D_NormalReposicao" name="Não · NORMAL"/>
    <bpmn:sequenceFlow id="Flow_D_Repor" sourceRef="Gateway_D_AbaixoReposicao" targetRef="Task_D_EmitirPedido" name="Sim · REPOR / CRITICO"/>
    <bpmn:sequenceFlow id="Flow_D_Pedido_Fim" sourceRef="Task_D_EmitirPedido" targetRef="End_D_Pedido"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Estoque">
    <bpmndi:BPMNPlane id="BPMNPlane_Estoque" bpmnElement="Collaboration_Estoque">
      <bpmndi:BPMNShape id="Shape_Participant_Deposito" bpmnElement="Participant_Deposito" isHorizontal="false">
        <dc:Bounds x="50" y="50" width="2200" height="1850"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Estoquista" bpmnElement="Lane_Estoquista" isHorizontal="false">
        <dc:Bounds x="50" y="50" width="650" height="1850"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Sistema" bpmnElement="Lane_Sistema" isHorizontal="false">
        <dc:Bounds x="700" y="50" width="1000" height="1850"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Gerencia" bpmnElement="Lane_Gerencia" isHorizontal="false">
        <dc:Bounds x="1700" y="50" width="550" height="1850"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Operacao" bpmnElement="Start_Operacao">
        <dc:Bounds x="110" y="110" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_TipoOperacao" bpmnElement="Gateway_TipoOperacao">
        <dc:Bounds x="290" y="103" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_A_Conferir" bpmnElement="Task_A_Conferir">
        <dc:Bounds x="440" y="230" width="190" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_A_ValidarFuncionarioValidade" bpmnElement="Task_A_ValidarFuncionarioValidade">
        <dc:Bounds x="760" y="230" width="200" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_A_ValidarArmazenamento" bpmnElement="Task_A_ValidarArmazenamento">
        <dc:Bounds x="1010" y="230" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_A_DadosCapacidadeValidos" bpmnElement="Gateway_A_DadosCapacidadeValidos">
        <dc:Bounds x="1290" y="255" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_A_BloquearNotificar" bpmnElement="Task_A_BloquearNotificar">
        <dc:Bounds x="1380" y="140" width="200" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_A_Excecao" bpmnElement="End_A_Excecao">
